{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "jest",
            "node"
        ],
        "lib": [
            "es2017",
            "dom",
            "esnext"
        ],
        "baseUrl": ".",
        "paths": {
            "../../src/*": [
                "../src/*"
            ],
            "../../generated/templates/cToken/cToken": [
                "../tests/__mocks__/generated/templates/cToken/cToken"
            ]
            // Removed "../../generated/*" path mapping to use actual generated schema
        }
    },
    "include": [
        "../jest-tests/**/*.ts"
    ]
}