{
  "extends": "@graphprotocol/graph-ts/types/tsconfig.base.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "../../src/*": [
        "src/*"
      ]
    },
    "types": [
      "matchstick-as",
      "@graphprotocol/graph-ts"
    ]
  },
  "include": [
    "src",
    "hardhat_scripts",
    "tests/handlers", // Only include handler tests for Matchstick compilation
    "tests/utils", // Include test utility files for Matchstick compilation
    "as-globals.d.ts" // Include custom AssemblyScript globals
  ],
  "exclude": [
    "node_modules",
    "tests/helpers" // Exclude Jest helper tests from Matchstick compilation
  ],
  "rootDir": "./",
}